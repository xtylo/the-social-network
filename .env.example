# Copy this file to .env (it is not committed to git)

# PostgreSQL + pgvector
POSTGRES_USER=tsn
POSTGRES_PASSWORD=tsn
POSTGRES_DB=tsn
DATABASE_URL=postgres://tsn:tsn@localhost:5432/tsn

# Emulated S3 (Floci)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=creator-content

# Services
API_PORT=3000
RECO_PORT=8080
RECO_URL=http://localhost:8080
